        list(APPEND REXGLUE_RECOMP_OPTIONS -fprofile-instr-generate)
        list(APPEND REXGLUE_RECOMP_LINK_OPTIONS -fprofile-instr-generate)
        list(APPEND REXGLUE_RECOMP_HOST_DEFINITIONS REXGLUE_RECOMP_PGO_GENERATE=1)
